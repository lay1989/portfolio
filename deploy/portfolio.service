# Template for a separate Linux portfolio VM. Do not install on the other project's VM.
[Unit]
Description=Lay Shah portfolio
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/srv/portfolio/current
EnvironmentFile=/etc/portfolio/portfolio.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/srv/portfolio/current/.venv/bin/python -m flask --app app check-runtime
ExecStart=/srv/portfolio/current/.venv/bin/gunicorn --config deploy/gunicorn.conf.py app:create_app()
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio

[Install]
WantedBy=multi-user.target
