# Protected /etc/portfolio/portfolio.env, owned by root, mode0600.
# Update trusted host + HTTPS URL for protected staging before using this template.
PORTFOLIO_ENV=production
SITE_URL=https://portfolio.example.invalid
TRUSTED_HOSTS=portfolio.example.invalid,localhost,127.0.0.1
# Required: generate privately on the portfolio host before starting.
SECRET_KEY=
DATABASE_URL=sqlite:////var/lib/portfolio/portfolio.sqlite3
MEDIA_ROOT=/var/lib/portfolio/media
TRUST_LOCAL_PROXY=true
SEARCH_INDEXING_ENABLED=true
WEB_CONCURRENCY=2
# Current owner choice: inquiries stay in the private dashboard. No email worker.
INQUIRY_EMAIL_ENABLED=false
