# Ubuntu template; install only on the portfolio VM after choosing log retention.
/var/log/nginx/portfolio-access.log /var/log/nginx/portfolio-error.log {
    daily
    rotate 7
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        /usr/sbin/nginx -s reopen
    endscript
}
